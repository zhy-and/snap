<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#f8f8f8"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="5dp"
        android:id="@+id/tops"
        >



        <ImageView
            android:padding="10dp"
            android:id="@+id/close_button"
            android:layout_width="wrap_content"
            android:src="@mipmap/backs"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/close_button"
            android:background="@drawable/search_ten"
            android:id="@+id/search_edit_text2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            >
            <TextView
            android:layout_marginStart="12dp"
            android:id="@+id/search"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@mipmap/search_btn"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
            <EditText
                android:maxLength="30"
                app:layout_constraintStart_toEndOf="@id/search"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/search_edit_text"
                android:layout_width="0dp"
                android:background="@null"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:hint="Search for a song or artist"
                android:textColorHint="#9E9E9E"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#000000"
                android:textSize="18sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>




    </androidx.constraintlayout.widget.ConstraintLayout>


    <HorizontalScrollView
        android:fillViewport="true"
        android:scrollbars="none"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tops"
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:paddingEnd="20dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginStart="18dp"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center"
                android:background="@drawable/select_search"
                android:text="ALL"
                android:id="@+id/all"
                android:textColor="#FFFFFF"
                android:layout_width="70dp"
                android:layout_height="28dp"/>
            <TextView
                android:layout_marginHorizontal="10dp"
                android:gravity="center"
                android:background="@drawable/unselect_search"
                android:textColor="#8C8C8C"
                android:text="Track"
                android:id="@+id/song"
                android:layout_width="70dp"
                android:layout_height="28dp"/>

            <TextView
                android:gravity="center"
                android:background="@drawable/unselect_search"
                android:textColor="#8C8C8C"

                android:text="Album"
                android:id="@+id/albums"
                android:layout_width="70dp"
                android:layout_height="28dp"/>
            <TextView
                android:layout_marginHorizontal="10dp"

                android:gravity="center"
                android:background="@drawable/unselect_search"
                android:textColor="#8C8C8C"

                android:text="Artist"
                android:id="@+id/artist"
                android:layout_width="70dp"
                android:layout_height="28dp"/>

            <TextView
                android:textColor="#8C8C8C"
                android:gravity="center"
                android:background="@drawable/unselect_search"
                android:text="Video"
                android:id="@+id/video"
                android:layout_width="70dp"
                android:layout_height="28dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>

    </HorizontalScrollView>

    <androidx.core.widget.NestedScrollView
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_container"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/ad_con"
                android:layout_height="wrap_content">
                <com.snap.intelligence.musics.mob.MobDiyView
                    android:visibility="gone"
                    android:layout_marginHorizontal="13dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:id="@+id/home_bans"
                    android:layout_width="match_parent"
                    app:gnt_template_type="@layout/banner_mob"
                    android:layout_height="wrap_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                app:layout_constraintTop_toBottomOf="@id/ad_con"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/all_container"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    android:id="@+id/song_title"
                    android:text="Track"
                    android:textColor="#000000"
                    android:layout_marginStart="14dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <ImageView
                    android:visibility="gone"

                    android:id="@+id/song_more"
                    android:layout_marginEnd="15dp"
                    app:layout_constraintBottom_toBottomOf="@id/song_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/song_title"
                    android:src="@mipmap/mores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintTop_toBottomOf="@id/song_title"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:visibility="gone"

                    android:id="@+id/line1"
                    android:layout_marginTop="15dp"
                    android:layout_marginHorizontal="18dp"
                    app:layout_constraintTop_toBottomOf="@id/list"
                    android:background="#E9E9E9"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>

                <TextView
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/line1"
                    app:layout_constraintStart_toStartOf="parent"
                    android:id="@+id/album_title"
                    android:text="Album"
                    android:textColor="#000000"

                    android:layout_marginStart="14dp"
                    android:layout_marginTop="16dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:visibility="gone"

                    android:id="@+id/album_more"
                    android:layout_marginEnd="15dp"
                    app:layout_constraintBottom_toBottomOf="@id/album_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/album_title"
                    android:src="@mipmap/mores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/album_list"
                    android:layout_marginTop="2dp"
                    android:layout_marginHorizontal="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/album_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <View
                    android:visibility="gone"

                    android:id="@+id/line2"
                    android:layout_marginTop="15dp"
                    android:layout_marginHorizontal="18dp"
                    app:layout_constraintTop_toBottomOf="@id/album_list"
                    android:background="#E9E9E9"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <TextView
                    android:id="@+id/artist_title"
                    app:layout_constraintTop_toBottomOf="@id/line2"
                    android:text="Artist"
                    app:layout_constraintStart_toStartOf="parent"
                    android:textColor="#000000"
                    android:visibility="gone"

                    android:layout_marginStart="14dp"
                    android:layout_marginTop="16dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <ImageView
                    android:visibility="gone"

                    android:id="@+id/artist_more"
                    android:layout_marginEnd="15dp"
                    app:layout_constraintBottom_toBottomOf="@id/artist_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/artist_title"
                    android:src="@mipmap/mores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/artist_list"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="18dp"
                    app:layout_constraintTop_toBottomOf="@id/artist_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:visibility="gone"

                    android:id="@+id/line3"
                    android:layout_marginTop="15dp"
                    android:layout_marginHorizontal="18dp"
                    app:layout_constraintTop_toBottomOf="@id/artist_list"
                    android:background="#E9E9E9"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <TextView
                    android:textColor="#000000"

android:visibility="gone"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="16dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:id="@+id/playlist_title"
                    android:text="Video"
                    app:layout_constraintStart_toStartOf="parent"

                    app:layout_constraintTop_toBottomOf="@id/line3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <ImageView
                    android:visibility="gone"
                    android:id="@+id/play_list_more"
                    android:layout_marginEnd="15dp"
                    app:layout_constraintBottom_toBottomOf="@id/playlist_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/playlist_title"
                    android:src="@mipmap/mores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/play_list"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="18dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/playlist_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <View
                    android:visibility="gone"

                    android:layout_marginHorizontal="18dp"
                    app:layout_constraintTop_toBottomOf="@id/album_list"
                    android:background="#E9E9E9"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/ad_con"

                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/song_container"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_marginTop="7dp"
                    android:layout_marginHorizontal="10dp"
                    android:id="@+id/unique_song_list"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />


            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/ad_con"

                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/albums_container"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/unique_album_list"
                    android:layout_marginTop="7dp"
                    android:layout_marginHorizontal="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />


            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/ad_con"

                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/artist_container"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/unique_artist_list"
                    android:layout_marginTop="15dp"
                    android:layout_marginHorizontal="18dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />


            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/ad_con"

                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/video_container"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/unique_video_list"
                    android:layout_marginTop="7dp"
                    android:layout_marginHorizontal="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />


            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                app:layout_constraintTop_toBottomOf="@id/ad_con"
                    android:visibility="gone"
                android:layout_marginTop="40dp"
                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/empty_result"
                android:layout_height="wrap_content">
                <ImageView

                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:id="@+id/em_iv"
                    android:src="@mipmap/empty_mus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    app:layout_constraintTop_toBottomOf="@id/em_iv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:id="@+id/em_tx"
                    android:layout_marginHorizontal="27dp"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="No result"
                    android:textColor="#FF909090"
                    android:textSize="14sp"
                    />
                <ImageView
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/em_tx"
                    android:layout_marginTop="34dp"
                    android:id="@+id/emo_scan"
                    android:src="@mipmap/on_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_marginTop="20dp"
                    android:layout_marginHorizontal="18dp"
                    app:layout_constraintTop_toBottomOf="@id/emo_scan"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_width="0dp"
                    android:lineSpacingExtra="10dp"
                    android:layout_height="wrap_content"
                    android:text="Discover the ultimate music experience with our player! Enjoy the newest hits and timeless classics in one place. With a vast, constantly updated library, you’ll find all your favorite songs and artists. High-quality streaming, personalized playlists, and seamless playback let you immerse in music anytime, anywhere. Start exploring—your perfect soundtrack awaits!"
                    android:textColor="#FFC1C1C1"
                    android:textSize="14sp"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@id/button_container"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="0dp">
        <io.supercharge.shimmerlayout.ShimmerLayout
            android:visibility="gone"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/spec_anm"
            app:shimmer_animation_duration="1000"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/item_search_animations"/>
        </io.supercharge.shimmerlayout.ShimmerLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>