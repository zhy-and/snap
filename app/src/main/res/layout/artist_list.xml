<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:mlns="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">
    <include
        android:id="@+id/tops"
        layout="@layout/include_on_titles"
        />
    <include
        android:id="@+id/bottom_player"
        layout="@layout/fragment_mini_player"
        />



    <androidx.core.widget.NestedScrollView
        mlns:layout_constraintTop_toBottomOf="@id/tops"
        mlns:layout_constraintBottom_toTopOf="@id/bottom_player"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_marginBottom="18dp"
        android:layout_height="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"

            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                mlns:layout_constraintTop_toTopOf="parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/container"
                android:orientation="vertical"
                >

                <ImageView
                    android:scaleType="centerCrop"
                    mlns:layout_constraintStart_toStartOf="parent"
                    mlns:layout_constraintEnd_toEndOf="parent"
                    mlns:layout_constraintTop_toTopOf="parent"
                    mlns:layout_constraintDimensionRatio="360:240"
                    android:id="@+id/thumbnailss"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    />

                <ImageView
                    android:background="@mipmap/art_on_shadow_bg"
                    android:scaleType="fitXY"
                    mlns:layout_constraintBottom_toBottomOf="@id/thumbnailss"
                    mlns:layout_constraintStart_toStartOf="parent"
                    mlns:layout_constraintEnd_toEndOf="parent"
                    mlns:layout_constraintDimensionRatio="360:124"
                    android:id="@+id/shadow"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    />

                <TextView
                    android:layout_marginBottom="30dp"
                    android:layout_marginStart="30dp"
                    android:textColor="#ffffff"
                    mlns:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:id="@+id/titles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold" />




                <ImageView
                    android:background="@mipmap/art_play"
                    mlns:layout_constraintEnd_toEndOf="parent"
                    mlns:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="12dp"
                    android:layout_marginEnd="16dp"
                    android:id="@+id/play_btns"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintDimensionRatio="H,1:1" />




            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                app:layout_constraintTop_toBottomOf="@id/container"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/ad_con"
                android:layout_height="wrap_content">
                <com.snap.intelligence.musics.mob.MobDiyView
                    android:layout_marginHorizontal="13dp"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:id="@+id/home_bans"
                    android:layout_width="match_parent"
                    app:gnt_template_type="@layout/banner_mob"
                    android:layout_height="wrap_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/ad_con"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/home_page_sections_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.core.widget.NestedScrollView>



    <io.supercharge.shimmerlayout.ShimmerLayout
        android:visibility="gone"
        mlns:layout_constraintTop_toBottomOf="@id/tops"
        mlns:layout_constraintBottom_toTopOf="@id/bottom_player"
        android:id="@+id/spec_anm"
        app:shimmer_animation_duration="1000"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp">
        <include layout="@layout/item_search_animations"/>
    </io.supercharge.shimmerlayout.ShimmerLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
