<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.start.HomeActivity"
    >

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <!--        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"-->


        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing"
            android:background="@mipmap/bg2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:expandedTitleMarginEnd="64dp"
            app:expandedTitleMarginStart="48dp"

            app:layout_scrollFlags="scroll|exitUntilCollapsed">
            <!--            <androidx.appcompat.widget.Toolbar-->
            <!--                android:id="@+id/toolbar"-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="?attr/actionBarSize"-->
            <!--                app:popupTheme="@style/ThemeOverlay.AppCompat.Light">-->


            <!--            </androidx.appcompat.widget.Toolbar>-->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_marginBottom="7dp"
                android:id="@+id/backdrop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="parallax">

                <TextView
                    android:layout_marginTop="50dp"
                    android:id="@+id/a"
                    app:layout_constraintTop_toTopOf="parent"
                    android:background="@mipmap/home_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_marginTop="15dp"
                    android:elevation="5dp"
                    android:background="@drawable/white_ten"
                    app:layout_constraintTop_toBottomOf="@id/a"
                    android:id="@+id/search_edit_text2"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
           >    <TextView
                    android:layout_marginStart="12dp"
                    android:id="@+id/search"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:background="@mipmap/home_search"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toEndOf="@id/search"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Search for a song or artist"
                        android:textColor="#FFB0B0B0"
                        android:textSize="16sp"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/tools"
                android:layout_marginTop="35dp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#00000000"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/tops"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    app:layout_collapseMode="pin"
                    app:layout_constraintStart_toStartOf="parent">
                    <!---->
                    <ImageView
                        android:id="@+id/end_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/about"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <!---->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:elevation="5dp"
                        android:visibility="gone"
                        android:background="@drawable/white_ten"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:id="@+id/search_edit_text"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="11dp"
                        android:layout_marginEnd="11dp"
                        app:layout_constraintEnd_toStartOf="@id/list_button"
                        app:layout_constraintStart_toEndOf="@id/end_btn"
                        >

                        <TextView
                        android:layout_marginStart="12dp"
                        android:id="@+id/search2"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:background="@mipmap/home_search"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                        <TextView
                            android:layout_marginStart="8dp"
                            app:layout_constraintStart_toEndOf="@id/search2"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Search for a song or artist"
                            android:textColor="#FFB0B0B0"
                            android:textSize="16sp"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <ImageView

                        android:id="@+id/list_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="15dp"
                        android:src="@mipmap/home_list"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <!---->
                    <!---->
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.appcompat.widget.Toolbar>


        </com.google.android.material.appbar.CollapsingToolbarLayout>


    </com.google.android.material.appbar.AppBarLayout>



    <include
        android:id="@+id/bottom_player"
        layout="@layout/fragment_mini_player"
        />


    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toTopOf="@id/bottom_player"
        app:layout_constraintTop_toBottomOf="@id/tops"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            app:layout_constraintTop_toBottomOf="@id/ad_con"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="33dp"
            android:id="@+id/topos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_marginEnd="7dp"
                app:layout_constraintHorizontal_weight="1"
                android:background="@mipmap/on_history"
                android:id="@+id/history"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/fav"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintDimensionRatio="140:34"
                android:layout_width="0dp"
                android:layout_height="0dp"/>

            <TextView
                android:layout_marginStart="7dp"
                app:layout_constraintHorizontal_weight="1"
                android:background="@mipmap/on_favourite"
                android:id="@+id/fav"
                app:layout_constraintStart_toEndOf="@id/history"
app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintDimensionRatio="140:34"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/ad_con"
        android:layout_height="wrap_content">
        <com.snap.intelligence.musics.mob.MobDiyView
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="7dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/home_bans"
            android:layout_width="match_parent"
            app:gnt_template_type="@layout/banner_mob"
            android:layout_height="wrap_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
             app:layout_constraintTop_toBottomOf="@id/topos"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/home_page_sections_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />


            <androidx.recyclerview.widget.RecyclerView
                app:layout_constraintTop_toBottomOf="@id/new_release_title"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="9dp"
                android:id="@+id/new_release_albums_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:visibility="gone"
                android:id="@+id/new_release_title"
                android:padding="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/home_page_sections_recycler_view"
                android:layout_width="match_parent"

                android:layout_height="wrap_content">
                <TextView
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:textSize="18sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:text="New release albums"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <ImageView
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:src="@mipmap/mores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:visibility="gone"
                android:id="@+id/mood_title"
                android:padding="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/line1"
                android:layout_width="match_parent"

                android:layout_height="wrap_content">
                <TextView
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:textSize="18sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:text="Mood and Genres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:visibility="gone"
                android:layout_marginHorizontal="12dp"
                android:id="@+id/line1"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/new_release_albums_recycler_view"
                android:background="#E9E9E9"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>

            <androidx.recyclerview.widget.RecyclerView
                app:layout_constraintTop_toBottomOf="@id/mood_title"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/mood_and_genres_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_marginHorizontal="12dp"
                android:id="@+id/line2"
                app:layout_constraintTop_toBottomOf="@id/mood_and_genres_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="80dp"/>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_marginTop="75dp"
                android:visibility="gone"
                android:id="@+id/empty_layout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/topos"
                app:layout_constraintEnd_toEndOf="parent"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/em_iv"
                    android:src="@mipmap/on_network"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/em_tx"
                    android:layout_marginHorizontal="27dp"
                    android:gravity="center"
                    android:layout_marginTop="30dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="There may be some network problems.
You can try clicking the button to refresh."
                    android:textColor="#FF909090"
                    android:textSize="14sp"
                    />

                <ImageView
                    android:layout_marginTop="34dp"
                    android:id="@+id/emo_scan"
                    android:src="@mipmap/on_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <io.supercharge.shimmerlayout.ShimmerLayout
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/topos"
                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/spec_anm"
                android:layout_marginTop="15dp"
                app:shimmer_animation_duration="1000"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="match_parent"
                android:layout_height="0dp">
                <include layout="@layout/item_search_animations"/>
            </io.supercharge.shimmerlayout.ShimmerLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>