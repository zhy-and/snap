<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <include
        android:id="@+id/tops"
        layout="@layout/include_on_titles"
        />
    <include
        android:id="@+id/bottom_player"
        layout="@layout/fragment_mini_player"
        />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@id/tops"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/ad_con"
        android:layout_height="wrap_content">
        <com.snap.intelligence.musics.mob.MobDiyView
            android:visibility="gone"
            android:layout_marginHorizontal="13dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/home_bans"
            android:layout_width="match_parent"
            app:gnt_template_type="@layout/banner_mob"
            android:layout_height="wrap_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toBottomOf="@id/ad_con"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/container"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/thumbnailo"
            android:layout_width="136dp"
            android:layout_height="136dp"
            app:layout_constraintDimensionRatio="1:1" />

        <TextView
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/thumbnailo"
            android:maxLines="2"
            android:textColor="#000000"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/thumbnailo"
            android:id="@+id/titles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_marginStart="12dp"
            android:textColor="#000000"
            android:lines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/titles"
            app:layout_constraintStart_toEndOf="@id/thumbnailo"
            android:id="@+id/artists"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginTop="10dp" />

        <ImageView
            android:background="@mipmap/album_playbtn"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/thumbnailo"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="10dp"
            android:id="@+id/play_btns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintDimensionRatio="H,1:1" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginBottom="18dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_player"
        app:layout_constraintTop_toBottomOf="@id/container"
        android:id="@+id/mood_and_genres_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@id/tops"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="0dp">
        <io.supercharge.shimmerlayout.ShimmerLayout
            android:visibility="gone"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/spec_anm2"
            app:shimmer_animation_duration="1000"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/item_search_animations"/>
        </io.supercharge.shimmerlayout.ShimmerLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
