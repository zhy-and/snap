<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:background="#f8f8f8"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="5dp"
        android:id="@+id/tops"
        >



        <ImageView
            android:padding="10dp"
            android:id="@+id/close_button"
            android:layout_width="wrap_content"
            android:src="@mipmap/backs"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/close_button"
            android:background="@drawable/search_ten"
            android:id="@+id/search_edit_text2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            >
            <TextView
            android:layout_marginStart="12dp"
            android:id="@+id/search"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@mipmap/search_btn"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
            <EditText
                app:layout_constraintStart_toEndOf="@id/search"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/search_edit_text"
                android:layout_width="0dp"
                android:background="@null"
                android:maxLength="30"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:hint="Search for a song or artist"
                android:textColorHint="#9E9E9E"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#000000"
                android:textSize="16sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>




    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@id/tops"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/ad_con"
        android:layout_height="wrap_content">
        <com.snap.intelligence.musics.mob.MobDiyView
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/home_bans"
            android:visibility="gone"
            android:layout_width="match_parent"
            app:gnt_template_type="@layout/banner_mob"
            android:layout_height="wrap_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginTop="15dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintTop_toBottomOf="@id/ad_con"
        android:id="@+id/flow_list"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:layout_marginHorizontal="18dp"
        app:layout_constraintTop_toBottomOf="@id/flow_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="10dp"
        android:text="Discover the ultimate music experience with our player! Enjoy the newest hits and timeless classics in one place. With a vast, constantly updated library, you’ll find all your favorite songs and artists. High-quality streaming, personalized playlists, and seamless playback let you immerse in music anytime, anywhere. Start exploring—your perfect soundtrack awaits!"
        android:textColor="#FFC1C1C1"
        android:textSize="14sp"
        />





</androidx.constraintlayout.widget.ConstraintLayout>